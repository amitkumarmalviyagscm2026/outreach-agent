# Copy this file to .env for local runs only. Never commit .env.
# In GitHub Actions these are read from repo Secrets instead (see .github/workflows/outreach.yml).

CRUSTDATA_API_KEY=your-crustdata-key-here

# Free, no credit card required -- get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here

# Optional backup LLM, used when Gemini is overloaded. Free, no credit card --
# get one at https://console.groq.com/keys
GROQ_API_KEY=your-groq-key-here
